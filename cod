};

export default function ReportLostPetDialog({ open, onOpenChange, onCreated }) {
  const [step, setStep] = useState('form');
  const [form, setForm] = useState(EMPTY);
  const [created, setCreated] = useState(null);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');

  const validate = () => {
    if (!form.pet_name.trim()) return 'Informe o nome do pet.';
    if (!form.title.trim()) return 'Escreva um título para o alerta.';
    if (!form.neighborhood) return 'Escolha o bairro onde o pet foi visto.';
