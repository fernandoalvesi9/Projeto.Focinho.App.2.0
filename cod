import { createClientFromRequest } from 'npm:@base44/sdk@0.8.52';

// Public data sources, no API keys required:
// - IBGE localidades API: official municipality names + codes
// - ViaCEP: CEP lookup
// - Open-Meteo geocoding: coordinates for matched municipalities

const CACHE_TTL_MS = 24 * 60 * 60 * 1000;
let citiesCache = null; // { loadedAt: number, cities: Array }
const coordsCache = new Map(); // "nome|uf" -> {lat,lng} | null
const cepCache = new Map(); // "digits" -> suggestions[]

function normalize(text) {
  return (text || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/\s+/g, ' ');
}

async function loadCities() {
  if (citiesCache && Date.now() - citiesCache.loadedAt < CACHE_TTL_MS) {
    return citiesCache.cities;
  }
  const res = await fetch(
    'https://servicodados.ibge.gov.br/api/v1/localidades/municipios?orderBy=nome',
    { signal: AbortSignal.timeout(30000) }
  );
  if (!res.ok) throw new Error(`ibge_${res.status}`);
  const data = await res.json();
  const cities = (Array.isArray(data) ? data : []).map((m) => ({
    id: String(m.id),
    nome: m.nome,
    uf: m?.microrregiao?.mesorregiao?.UF?.sigla || '',
    ufNome: m?.microrregiao?.mesorregiao?.UF?.nome || '',
    key: normalize(m.nome),
  }));
  citiesCache = { loadedAt: Date.now(), cities };
  return cities;
}

function rankMatches(cities, term) {
  const scored = [];
  for (const city of cities) {
    let score = -1;
    if (city.key === term) score = 0;
    else if (city.key.startsWith(term)) score = 1;
    else if (city.key.includes(term)) score = 2;
    if (score >= 0) scored.push({ city, score });
  }
  scored.sort(
    (a, b) => a.score - b.score || a.city.nome.localeCompare(b.city.nome, 'pt-BR')
  );
  return scored.slice(0, 6).map((s) => s.city);
}

async function fetchCoords(city) {
  const key = `${city.key}|${city.uf}`;
  if (coordsCache.has(key)) return coordsCache.get(key);
  try {
    const url = `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(
      city.nome
    )}&count=10&language=pt&format=json`;
    const res = await fetch(url, { signal: AbortSignal.timeout(10000) });
    if (!res.ok) throw new Error(`geocode_${res.status}`);
    const data = await res.json();
    const brResults = (data.results || []).filter((r) => r.country_code === 'BR');
    const match =
      brResults.find(
        (r) =>
          r.name === city.nome && normalize(r.admin1 || '') === normalize(city.ufNome)
      ) ||
      brResults.find((r) => r.name === city.nome) ||
      brResults.find((r) => normalize(r.admin1 || '') === normalize(city.ufNome)) ||
      brResults[0];
    const coords = match
      ? {
          lat: Math.round(match.latitude * 10000) / 10000,
          lng: Math.round(match.longitude * 10000) / 10000,
        }
      : null;
    coordsCache.set(key, coords);
    return coords;
  } catch (err) {
    coordsCache.set(key, null);
    return null;
  }
}

async function cepSuggestion(q) {
  const digits = q.replace(/\D/g, '');
  if (digits.length !== 8) return [];
  if (cepCache.has(digits)) return cepCache.get(digits);
  let out = [];
  try {
    const res = await fetch(`https://viacep.com.br/ws/${digits}/json/`, {
      signal: AbortSignal.timeout(10000),
    });
    if (!res.ok) throw new Error(`viacep_${res.status}`);
    const data = await res.json();
    if (data && !data.erro && data.localidade) {
      out = [
        {
          type: 'cep',
          id: `cep-${digits}`,
          cep: data.cep,
          nome: data.localidade,
          uf: data.uf || '',
          ufNome: '',
          label: `${data.localidade}${data.uf ? ` - ${data.uf}` : ''}`,
          lat: null,
          lng: null,
        },
      ];
    }
  } catch (err) {
    out = [];
  }
  cepCache.set(digits, out);
  return out;
}

export default async function (req) {
  try {
    const base44 = createClientFromRequest(req);
    if (req.method !== 'POST') {
      return Response.json({ error: 'Method not allowed' }, { status: 405 });
    }
    const body = await req.json().catch(() => ({}));
    const q = String(body.q || '').trim().slice(0, 60);
    if (q.length < 2) return Response.json({ suggestions: [] });

    // CEP input: digits/punctuation only
    const digits = q.replace(/\D/g, '');
    if (/^[\d\s.\-]+$/.test(q) && digits.length >= 5) {
      const suggestions = await cepSuggestion(q);
      return Response.json({ suggestions });
    }

    const cities = await loadCities();
    const term = normalize(q);
    const top = rankMatches(cities, term);
    if (!top.length) return Response.json({ suggestions: [] });

    const settled = await Promise.allSettled(top.map((city) => fetchCoords(city)));
    const suggestions = top.map((city, index) => {
      const coords =
        settled[index].status === 'fulfilled' ? settled[index].value : null;
      return {
        type: 'city',
        id: city.id,
        nome: city.nome,
        uf: city.uf,
        ufNome: city.ufNome,
        label: `${city.nome}${city.uf ? ` - ${city.uf}` : ''}`,
        lat: coords?.lat ?? null,
        lng: coords?.lng ?? null,
      };
    });
    return Response.json({ suggestions });
  } catch (error) {
    return Response.json({ error: error.message }, { status: 500 });
  }
}

