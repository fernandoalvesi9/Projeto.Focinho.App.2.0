        reporter_name: user?.full_name || 'Tutor',
        reporter_email: user?.email || '',
        reported_at: new Date().toISOString(),
        lat,
        lng,
        is_demo: false,
      });
      setCreated(record);
      onCreated?.(record);
      setStep('done');
    } catch (err) {
      setError('Não foi possível publicar o alerta agora. Tente novamente.');
    } finally {
      setSaving(false);
