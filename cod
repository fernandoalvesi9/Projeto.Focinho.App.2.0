      .catch(() => setPets([]));
  }, []);

  const runSearch = async (nextCategory, nextQuery, nextLocation, searchLocation) => {
    setCategory(nextCategory);
    setQuery(nextQuery);
    setLocation(nextLocation);
    setSearchError('');
    setSearching(true);
    const locationTerm = (searchLocation ?? nextLocation).trim();
    try {
      const conditions = { active: true };
      if (nextCategory !== 'Todos') {
        conditions.provider_type = nextCategory === 'Pet shops' ? 'Pet shop' : nextCategory;
      }
      const groups = [];
      if (nextQuery.trim()) {
        const term = escapeRegex(nextQuery.trim());
        groups.push({
          $or: ['name', 'provider_type', 'headline', 'bio', 'neighborhood'].map((field) => ({
            [field]: { $regex: term, $options: 'i' },
          })),
        });
      }
      if (locationTerm) {
        const place = escapeRegex(locationTerm);
        groups.push({
          $or: [{ city: { $regex: place, $options: 'i' } }, { neighborhood: { $regex: place, $options: 'i' } }],
        });
      }
      if (groups.length) conditions.$and = groups;
      const { items } = await base44.entities.Provider.filter(conditions, { sort: '-rating', limit: 60 });
      setResults(items);
    } catch (err) {
      setSearchError('Não foi possível carregar os resultados agora. Tente novamente.');
