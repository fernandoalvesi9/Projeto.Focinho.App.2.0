  };

  const goToReview = (event) => {
    event.preventDefault();
    const problem = validate();
    if (problem) {
      setError(problem);
      return;
    }
    setError('');
    setStep('review');
  };

  const publish = async () => {
    setError('');
    setSaving(true);
    try {
      const authed = await base44.auth.isAuthenticated();
      if (!authed) {
        base44.auth.redirectToLogin('/pets-perdidos');
        return;
      }
      const user = await base44.auth.me();
      const { lat, lng } = coordinatesFor(form.neighborhood);
