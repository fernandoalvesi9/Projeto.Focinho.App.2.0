import React, { useEffect, useRef, useState } from 'react';
import { base44 } from '@/api/base44Client';
import { Loader2, MapPin, Search } from 'lucide-react';
import { Input } from '@/components/ui/input';

export default function LocationAutocomplete({ value, onChange, onSelect }) {
  const [suggestions, setSuggestions] = useState([]);
  const [loading, setLoading] = useState(false);
  const [open, setOpen] = useState(false);
  const [sourceError, setSourceError] = useState('');
  const [highlight, setHighlight] = useState(-1);
  const requestId = useRef(0);
  const selectedLabelRef = useRef(null);
  const boxRef = useRef(null);

  useEffect(() => {
    const q = value.trim();
    if (q.length < 2 || q === selectedLabelRef.current) {
      setSuggestions([]);
      setLoading(false);
      setSourceError('');
      if (q.length < 2) setOpen(false);
      return;
    }
    const id = ++requestId.current;
    setLoading(true);
    const timer = setTimeout(async () => {
      try {
        const res = await base44.functions.invoke('locationSuggestions', { q });
        if (id !== requestId.current) return;
        setSuggestions(res.data?.suggestions || []);
        setSourceError('');
        setOpen(true);
        setHighlight(-1);
      } catch (err) {
        if (id !== requestId.current) return;
        setSuggestions([]);
        setSourceError('Não foi possível consultar as cidades agora.');
        setOpen(true);
        setHighlight(-1);
      } finally {
        if (id === requestId.current) setLoading(false);
      }
    }, 300);
    return () => clearTimeout(timer);
  }, [value]);

  useEffect(() => {
    const handleClickOutside = (event) => {
      if (boxRef.current && !boxRef.current.contains(event.target)) setOpen(false);
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const pick = (suggestion) => {
    selectedLabelRef.current = suggestion.label;
    onChange(suggestion.label);
    onSelect(suggestion);
    setOpen(false);
  };

  const pickManual = () => {
    selectedLabelRef.current = null;
    const text = value.trim();
    onChange(text);
    onSelect(null);
    setOpen(false);
  };

  const onKeyDown = (event) => {
    if (!open || (!suggestions.length && !sourceError)) {
      if (event.key === 'Escape') setOpen(false);
      return;
    }
    const rows = suggestions.length ? suggestions.length + 1 : 1; // +1 manual row
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setHighlight((h) => (h + 1) % rows);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      setHighlight((h) => (h <= 0 ? rows - 1 : h - 1));
    } else if (event.key === 'Enter' && highlight >= 0) {
      event.preventDefault();
      if (suggestions.length && highlight < suggestions.length) pick(suggestions[highlight]);
      else pickManual();
    } else if (event.key === 'Escape') {
      setOpen(false);
    }
  };

  const q = value.trim();

  return (
    <div className="relative" ref={boxRef}>
      <MapPin className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
      <Input
        value={value}
        onChange={(e) => {
          selectedLabelRef.current = null;
          onChange(e.target.value);
        }}
        onFocus={() => {
          if (suggestions.length && !loading) setOpen(true);
        }}
        onKeyDown={onKeyDown}
        placeholder="Cidade, estado ou CEP"
        className="h-12 rounded-xl pl-10 pr-10 text-base"
        aria-label="Localização"
        autoComplete="off"
      />
      {loading ? (
        <Loader2 className="absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 animate-spin text-muted-foreground" />
      ) : null}

      {open && !loading ? (
        <div className="absolute left-0 right-0 top-full z-50 mt-1 max-h-72 overflow-auto rounded-xl border border-border bg-card py-1 shadow-lg">
          {sourceError ? (
            <div className="px-4 py-3 text-sm text-muted-foreground">
              {sourceError} Digite e use o botão Buscar para pesquisar com o texto digitado.
            </div>
          ) : suggestions.length ? (
            <>
              {suggestions.map((s, index) => (
                <button
                  key={`${s.type}-${s.id}`}
                  type="button"
                  onMouseDown={(e) => e.preventDefault()}
                  onClick={() => pick(s)}
                  className={
                    'flex w-full items-center gap-2.5 px-4 py-2.5 text-left transition-colors hover:bg-accent ' +
                    (highlight === index ? 'bg-accent' : '')
                  }
                >
                  <MapPin className="h-4 w-4 shrink-0 text-muted-foreground" />
                  <span className="min-w-0 flex-1 truncate text-base">
                    {s.nome}
                    {s.uf ? <span className="text-muted-foreground"> - {s.uf}</span> : null}
                  </span>
                </button>
              ))}
              <button
                type="button"
                onMouseDown={(e) => e.preventDefault()}
                onClick={pickManual}
                className={
                  'flex w-full items-center gap-2.5 border-t border-border px-4 py-2.5 text-left transition-colors hover:bg-accent ' +
                  (highlight === suggestions.length ? 'bg-accent' : '')
                }
              >
                <Search className="h-4 w-4 shrink-0 text-muted-foreground" />
                <span className="min-w-0 flex-1 truncate text-base">
                  Buscar pelo texto digitado: <strong className="font-semibold">“{q}”</strong>
                </span>
              </button>
            </>
          ) : (
            <div className="px-4 py-3 text-sm">
              <p className="text-muted-foreground">
                Nenhuma cidade ou CEP encontrado para “{q}”.
              </p>
              <button
                type="button"
                onMouseDown={(e) => e.preventDefault()}
                onClick={pickManual}
                className="mt-1 text-sm font-medium text-primary hover:underline"
              >
                Buscar pelo texto digitado
              </button>
            </div>
          )}
        </div>
      ) : null}
    </div>
  );
}


