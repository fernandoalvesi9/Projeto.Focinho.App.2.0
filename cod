import ReportCard from '@/components/moderation/ReportCard';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Skeleton } from '@/components/ui/skeleton';
import { relativeTime } from '@/lib/format';

export default function Moderacao() {
  const [loading, setLoading] = useState(true);
  const [allowed, setAllowed] = useState(false);
  const [reports, setReports] = useState([]);
  const [pets, setPets] = useState([]);

  useEffect(() => {
    let active = true;
    (async () => {
      try {
        const user = await base44.auth.me();
        if (!active) return;
        if (user?.role !== 'admin') {
          setAllowed(false);
          return;
        }
        setAllowed(true);
        const [reportList, petList] = await Promise.all([
          base44.entities.Report.list('-created_date', 100),
          base44.entities.LostPet.list('-reported_at', 100),
        ]);
        if (!active) return;
        setReports(reportList);
        setPets(petList);
      } finally {
        if (active) setLoading(false);
      }
    })();
    return () => { active = false; };
  }, []);

  const petFor = (report) => pets.find((pet) => pet.id === report.target_id);

  const reviewReport = async (report, status) => {
    const note = status === 'Procedente'
      ? 'Denúncia aceita pela moderação.'
      : 'Conteúdo verificado e mantido.';
    await base44.entities.Report.update(report.id, {
      status,
      moderation_note: note,
      reviewed_at: new Date().toISOString(),
    });
    setReports((prev) => prev.map((item) => (item.id === report.id ? { ...item, status, moderation_note: note } : item)));
  };

  const setHidden = async (pet, hidden) => {
    await base44.entities.LostPet.update(pet.id, { hidden });
    setPets((prev) => prev.map((item) => (item.id === pet.id ? { ...item, hidden } : item)));
  };

