import React, { useEffect, useState } from 'react';
import { Link, useParams } from 'react-router-dom';
import { ArrowLeft } from 'lucide-react';
import { base44 } from '@/api/base44Client';
import ReviewForm from '@/components/providers/ReviewForm';
import RatingSummary from '@/components/providers/RatingSummary';
import { Button } from '@/components/ui/button';
import { Skeleton } from '@/components/ui/skeleton';
import { formatDateTime } from '@/lib/format';

const STATUS_INFO = {
  Novo: 'O prestador recebeu a sua solicitação e responde pelo contato informado.',
  Respondido: 'O prestador respondeu — combine os detalhes direto com ele.',
  'Concluído': 'Serviço concluído. Agora você pode avaliar o prestador.',
  Cancelado: 'Esta solicitação foi cancelada.',
};

export default function RequestTracking() {
  const { id } = useParams();
  const [request, setRequest] = useState(null);
  const [provider, setProvider] = useState(null);
  const [loading, setLoading] = useState(true);
  const [reviewed, setReviewed] = useState(false);

  useEffect(() => {
    let active = true;
    (async () => {
      try {
        const data = await base44.entities.ContactRequest.get(id);
        if (!active) return;
        setRequest(data);
        setReviewed(Boolean(data.reviewed));
        if (data.provider_id) {
          const providerData = await base44.entities.Provider.get(data.provider_id).catch(() => null);
          if (active) setProvider(providerData);
        }
      } catch (err) {
        if (active) setRequest(null);
      } finally {
        if (active) setLoading(false);
      }
    })();
    return () => { active = false; };
  }, [id]);

  if (loading) {
    return (
      <div className="mx-auto max-w-2xl space-y-4 px-4 py-12">
        <Skeleton className="h-32 rounded-3xl" />
        <Skeleton className="h-56 rounded-3xl" />
      </div>
    );
  }

  if (!request) {
    return (
      <div className="mx-auto max-w-2xl px-4 py-20 text-center">
        <h1 className="font-heading text-2xl font-semibold">Solicitação não encontrada</h1>
        <p className="mt-2 text-muted-foreground">Confira o link recebido do prestador ou faça uma nova solicitação.</p>
        <Button asChild className="mt-6"><Link to="/">Voltar para a busca</Link></Button>
      </div>
    );
  }

  const done = request.status === 'Concluído';

  return (
    <div className="mx-auto max-w-2xl px-4 py-8 sm:py-12">
      <Link to="/" className="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground">
        <ArrowLeft className="h-4 w-4" />
        Voltar para a busca
      </Link>

      <div className="mt-5 rounded-3xl border border-border/70 bg-card p-5 sm:p-6">
        <p className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Acompanhar solicitação</p>
        <h1 className="mt-2 font-heading text-2xl font-semibold tracking-tight">{request.provider_name}</h1>
        <p className="mt-1 text-sm text-muted-foreground">
          {request.service_label ? `${request.service_label} · ` : ''}
          solicitado por {request.client_name}
        </p>

        <div className="mt-4 rounded-2xl bg-secondary/60 p-4">
          <p className="font-medium">{request.status}</p>
          <p className="mt-1 text-sm text-muted-foreground">{STATUS_INFO[request.status] || ''}</p>
          {request.completed_at ? (
            <p className="mt-2 text-xs text-muted-foreground">Concluído em {formatDateTime(request.completed_at)}</p>
          ) : null}
        </div>

        {provider ? (
          <div className="mt-4 flex flex-wrap items-center justify-between gap-3">
            <RatingSummary rating={provider.rating} count={provider.reviews_count} />
            <Button asChild variant="outline" size="sm">
              <Link to={`/prestador/${provider.id}`}>Ver perfil do prestador</Link>
            </Button>
          </div>
        ) : null}
      </div>

      <div className="mt-6 rounded-3xl border border-border/70 bg-card p-5 sm:p-6">
        <h2 className="font-heading text-lg font-semibold">Avaliação do serviço</h2>
        {done && !reviewed ? (
          <>
            <p className="mt-2 text-sm text-muted-foreground">
              Sua avaliação fica ligada a esta contratação e ajuda outros tutores a escolherem com segurança.
            </p>
            <div className="mt-4">
              <ReviewForm
                request={request}
                onSubmitted={() => setReviewed(true)}
              />
            </div>
          </>
        ) : null}

        {reviewed ? (
          <p className="mt-2 text-sm text-muted-foreground">
            Avaliação registrada. Obrigado por compartilhar sua experiência — ela já aparece no perfil do
            prestador.
          </p>
        ) : null}

        {!done && !reviewed ? (
          <p className="mt-2 text-sm text-muted-foreground">
            A avaliação é liberada quando o prestador marca o serviço como concluído. Assim, só avalia quem
            realmente contratou o serviço pelo Focinho.
          </p>
        ) : null}
      </div>
    </div>
  );
}




