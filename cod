                  </SelectTrigger>
                  <SelectContent>
                    {services.map((service) => (
                      <SelectItem key={service.id} value={service.label}>{service.label}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
              <div className="space-y-2">
                <Label htmlFor="message">Sobre o seu pet</Label>
                <Textarea
                  id="message"
                  value={form.message}
                  onChange={set('message')}
                  placeholder="Conte o porte do pet, o bairro e os dias que você precisa."
                  rows={3}
                />
              </div>
              {error ? <p className="text-sm text-destructive">{error}</p> : null}
              <Button type="submit" className="w-full" disabled={saving}>
                {saving ? 'Enviando...' : 'Enviar solicitação'}
