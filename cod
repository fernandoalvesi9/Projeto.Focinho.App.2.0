import React, { useState } from 'react';
import { Check, ShieldAlert } from 'lucide-react';
import { base44 } from '@/api/base44Client';
import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from '@/components/ui/dialog';
import { Button } from '@/components/ui/button';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { REPORT_REASONS } from '@/lib/pets';

export default function ReportDialog({
  targetType = 'Alerta de pet',
  targetId,
  targetLabel,
  open,
  onOpenChange,
  onReported,
}) {
  const [reason, setReason] = useState('');
  const [details, setDetails] = useState('');
  const [saving, setSaving] = useState(false);
  const [sent, setSent] = useState(false);
  const [error, setError] = useState('');

  const close = (next) => {
    onOpenChange(next);
    if (!next) {
      setReason('');
      setDetails('');
      setSent(false);
      setError('');
    }
  };

  const submit = async (event) => {
    event.preventDefault();
    if (!reason) {
      setError('Escolha o motivo da denúncia.');
      return;
    }
    setError('');
    setSaving(true);
    try {
      const authed = await base44.auth.isAuthenticated();
      if (!authed) {
        base44.auth.redirectToLogin();
        return;
      }
      const user = await base44.auth.me();
      await base44.entities.Report.create({
        target_type: targetType,
        target_id: targetId,
        target_label: targetLabel || '',
        reason,
        details: details.trim(),
        reporter_email: user?.email || '',
        status: 'Pendente',
      });
      setSent(true);
      onReported?.();
    } catch (err) {
      setError('Não foi possível registrar a denúncia agora. Tente novamente.');
    } finally {
      setSaving(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={close}>
      <DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-md">
        {sent ? (
          <div className="py-4 text-center">
            <span className="mx-auto grid h-12 w-12 place-items-center rounded-full bg-emerald-100 text-emerald-700">
              <Check className="h-6 w-6" />
            </span>
            <DialogTitle className="mt-4 font-heading text-xl">Denúncia registrada</DialogTitle>
            <p className="mt-2 text-sm text-muted-foreground">
              Obrigado por avisar. A moderação do Focinho vai analisar este conteúdo e o alerta fica marcado como
              “sob análise” enquanto isso.
            </p>
            <Button className="mt-6 h-11 w-full" onClick={() => close(false)}>Fechar</Button>
          </div>
        ) : (
          <>
            <DialogHeader>
              <DialogTitle className="font-heading text-xl">Denunciar</DialogTitle>
              <DialogDescription>
                Conte o que está errado {targetLabel ? `em “${targetLabel}”` : 'neste conteúdo'}.
              </DialogDescription>
            </DialogHeader>
            <form className="space-y-4" onSubmit={submit}>
              <div className="space-y-2">
                <Label>Motivo</Label>
                <Select value={reason} onValueChange={setReason}>
                  <SelectTrigger className="h-11">
