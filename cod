      .then((user) => {
        if (!active || !user) return;
        setForm((prev) => ({
          ...prev,
          reporter_name: prev.reporter_name || user.full_name || '',
          reporter_email: prev.reporter_email || user.email || '',
        }));
      })
      .catch(() => {});
    return () => { active = false; };
  }, [open, pet]);

  const locate = () => {
    if (!navigator.geolocation) {
      setGeo('unsupported');
      return;
    }
    setGeo('loading');
    navigator.geolocation.getCurrentPosition(
      (position) => {
        setCoords({ lat: position.coords.latitude, lng: position.coords.longitude });
        setGeo('done');
      },
      () => setGeo('denied'),
      { timeout: 8000 }
    );
  };

  const submit = async (event) => {
    event.preventDefault();
    if (!form.spot.trim()) {
      setError('Descreva o local onde você viu o pet.');
      return;
    }
    setError('');
    setSaving(true);
    try {
      const authed = await base44.auth.isAuthenticated();
      if (!authed) {
        base44.auth.redirectToLogin(`/pets-perdidos/${pet.id}`);
        return;
      }
      const user = await base44.auth.me();
      const sighting = await base44.entities.Sighting.create({
        lost_pet_id: pet.id,
        pet_name: pet.pet_name,
        pet_owner_email: pet.reporter_email || '',
        reporter_name: form.reporter_name.trim() || user?.full_name || 'Vizinho',
        reporter_email: form.reporter_email.trim() || user?.email || '',
        spot: form.spot.trim(),
        neighborhood: form.neighborhood,
        city: pet.city,
        seen_date: form.seen_date,
        seen_time: form.seen_time,
        comment: form.comment.trim(),
        photo_url: form.photo_url,
        lat: coords?.lat,
        lng: coords?.lng,
        status: 'Novo',
      });
      setSent(true);
      onCreated?.(sighting);
    } catch (err) {
      setError('Não foi possível enviar o avistamento agora. Tente novamente.');
    } finally {
      setSaving(false);
    }
  };

  const close = (next) => {
    onOpenChange(next);
    if (!next) {
      setForm({ ...EMPTY, seen_date: new Date().toISOString().slice(0, 10) });
      setCoords(null);
      setGeo('idle');
      setSent(false);
      setError('');
    }
  };

  const geoMessage = {
    idle: 'Se você autorizar, marcamos a região aproximada de onde viu o pet.',
    loading: 'Buscando sua localização...',
    done: 'Localização aproximada anexada ao avistamento.',
    denied: 'Não conseguimos acessar sua localização. Você pode descrever o local no campo acima.',
    unsupported: 'Seu navegador não permite localização. Descreva o local no campo acima.',
  }[geo];

  return (
    <Dialog open={open} onOpenChange={close}>
      <DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-lg">
        {sent ? (
          <div className="py-4 text-center">
            <span className="mx-auto grid h-12 w-12 place-items-center rounded-full bg-emerald-100 text-emerald-700">
