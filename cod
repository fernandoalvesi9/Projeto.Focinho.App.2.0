import { isResolved } from '@/lib/pets';
import { cn } from '@/lib/utils';

const FILTERS = ['Todos', 'Perdidos', 'Encontrados'];

export default function LostPets() {
  const [pets, setPets] = useState([]);
  const [loading, setLoading] = useState(true);
  const [filter, setFilter] = useState('Todos');
  const [open, setOpen] = useState(false);

  useEffect(() => {
    base44.entities.LostPet.list('-reported_at', 60)
      .then(setPets)
      .finally(() => setLoading(false));

    const unsubscribe = base44.entities.LostPet.subscribe((event) => {
      if (event.type === 'create') setPets((prev) => [event.data, ...prev]);
      if (event.type === 'update') setPets((prev) => prev.map((pet) => (pet.id === event.data.id ? event.data : pet)));
      if (event.type === 'delete') setPets((prev) => prev.filter((pet) => pet.id !== event.data.id));
    });
    return unsubscribe;
  }, []);

  const visible = useMemo(() => {
    const listed = pets.filter((pet) => !pet.hidden);
    if (filter === 'Perdidos') return listed.filter((pet) => !isResolved(pet));
    if (filter === 'Encontrados') return listed.filter((pet) => isResolved(pet));
    // Casos ativos primeiro — alertas resolvidos ficam no fim da lista.
    return [...listed.filter((pet) => !isResolved(pet)), ...listed.filter((pet) => isResolved(pet))];
  }, [pets, filter]);

  return (
    <div className="mx-auto max-w-6xl px-4 py-10 sm:py-14">
      <div className="flex flex-wrap items-end justify-between gap-4">
