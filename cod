import React, { useState } from 'react';
import { LocateFixed, Loader2, Search } from 'lucide-react';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import LocationAutocomplete from '@/components/home/LocationAutocomplete';
import { cn } from '@/lib/utils';

export default function SearchFilters({
  query,
  onQueryChange,
  location,
  onLocationChange,
  onLocationSelect,
  category,
  onCategoryChange,
  categories,
  onSearch,
  searching,
}) {
  const [geoBusy, setGeoBusy] = useState(false);
  const [geoError, setGeoError] = useState('');

  const useMyLocation = () => {
    if (!navigator.geolocation) {
      setGeoError('Seu navegador não permite localização. Digite sua cidade.');
      return;
    }
    setGeoError('');
    setGeoBusy(true);
    navigator.geolocation.getCurrentPosition(
      async ({ coords }) => {
        try {
          const res = await fetch(
            `https://nominatim.openstreetmap.org/reverse?format=jsonv2&accept-language=pt-BR&lat=${coords.latitude}&lon=${coords.longitude}`
          );
          const data = await res.json();
          const address = data?.address || {};
          const city =
            address.city || address.town || address.village || address.municipality || address.county;
          const label = [city, address.state].filter(Boolean).join(', ');
          if (label) {
            onLocationChange(label);
          } else {
            setGeoError('Não foi possível identificar sua cidade. Digite manualmente.');
          }
        } catch (err) {
          setGeoError('Não foi possível identificar sua localização. Digite manualmente.');
        } finally {
          setGeoBusy(false);
        }
      },
      () => {
        setGeoBusy(false);
        setGeoError('Permissão de localização recusada. Digite sua cidade ou CEP.');
      },
      { timeout: 10000 }
    );
  };

  return (
    <div className="rounded-3xl border border-border/70 bg-card p-4 shadow-sm sm:p-5">
      <div className="flex flex-wrap gap-2">
        {categories.map((item) => (
          <button
            key={item}
            type="button"
            onClick={() => onCategoryChange(item)}
            aria-pressed={category === item}
            className={cn(
              'rounded-full border px-4 py-2 text-sm font-medium transition-colors',
              category === item
                ? 'border-primary bg-primary text-primary-foreground'
                : 'border-border bg-background text-muted-foreground hover:text-foreground'
            )}
          >
            {item}
          </button>
        ))}
      </div>

      <form
        className="mt-4 grid gap-3 sm:grid-cols-[1fr_240px_auto]"
        onSubmit={(event) => {
          event.preventDefault();
          onSearch();
        }}
      >
        <div className="relative">
          <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
          <Input
            value={query}
            onChange={(e) => onQueryChange(e.target.value)}
            placeholder="Busque por serviço, nome ou bairro"
            className="h-12 rounded-xl pl-10 text-base"
            aria-label="Buscar serviços"
          />
        </div>
        <LocationAutocomplete
          value={location}
          onChange={onLocationChange}
          onSelect={onLocationSelect}
        />
        <Button type="submit" className="h-12 rounded-xl px-8" disabled={searching}>
          {searching ? <Loader2 className="h-4 w-4 animate-spin" /> : 'Buscar'}
        </Button>
      </form>

      <div className="mt-2 flex flex-wrap items-center gap-3">
        <button
          type="button"
          onClick={useMyLocation}
          disabled={geoBusy}
          className="inline-flex items-center gap-1.5 text-xs font-medium text-primary hover:underline disabled:opacity-60"
        >
          {geoBusy ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <LocateFixed className="h-3.5 w-3.5" />}
          Usar minha localização
        </button>
        {geoError ? <span className="text-xs text-destructive">{geoError}</span> : null}
      </div>
    </div>
  );
}


