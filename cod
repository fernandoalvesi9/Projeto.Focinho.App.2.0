          </div>
        ) : (
          <>
            <DialogHeader>
              <DialogTitle className="font-heading text-xl">Solicitar contato</DialogTitle>
              <DialogDescription>
                {provider.name} recebe seus dados direto, sem intermediário.
              </DialogDescription>
            </DialogHeader>
            <form className="space-y-4" onSubmit={submit}>
              <div className="space-y-2">
