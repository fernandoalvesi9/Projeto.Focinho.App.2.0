            <p className="mt-2 text-sm text-muted-foreground">
              Obrigado por ajudar! O responsável e a moderação veem esta informação na página do alerta. Seus dados
              de contato não ficam visíveis para outras pessoas.
            </p>
            <Button className="mt-6 h-11 w-full" onClick={() => close(false)}>Fechar</Button>
          </div>
        ) : (
          <>
            <DialogHeader>
              <DialogTitle className="font-heading text-xl">Vi este pet</DialogTitle>
              <DialogDescription>
