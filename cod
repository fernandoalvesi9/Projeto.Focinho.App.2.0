/** Recalcula a nota do prestador a partir das avaliações realmente existentes. */
export async function refreshProviderRating(providerId) {
  const reviews = await base44.entities.Review.filter({ provider_id: providerId });
  const count = reviews.length;
  const average = count
    ? reviews.reduce((sum, review) => sum + (Number(review.rating) || 0), 0) / count
    : 0;
  await base44.entities.Provider.update(providerId, {
    rating: Number(average.toFixed(1)),
    reviews_count: count,
  });
  return { rating: Number(average.toFixed(1)), count };
}


