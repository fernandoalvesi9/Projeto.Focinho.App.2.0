import { createClientFromRequest } from 'npm:@base44/sdk@0.8.52';
import OpenAI from 'npm:openai@6.45.0';

const ALLOWED_HOST = 'https://media.base44.com/';

export default async function (req) {
  try {
    const base44 = createClientFromRequest(req);
    const user = await base44.auth.me();
    if (!user) return Response.json({ error: 'Unauthorized' }, { status: 401 });

    const body = await req.json().catch(() => ({}));
    const referenceUrl = typeof body?.referenceUrl === 'string' ? body.referenceUrl : '';
    if (!referenceUrl.startsWith(ALLOWED_HOST)) {
      return Response.json({ error: 'Invalid reference image' }, { status: 400 });
    }

    const { baseURL, token, headers } = base44.asServiceRole.aiGateway.connection();
    const client = new OpenAI({ baseURL, apiKey: token, defaultHeaders: headers, maxRetries: 0 });

    const { data } = await client.images.generate({
      model: 'gpt_image_2',
      prompt:
        'Redraw only the line-art animal snout symbol (a "focinho" / dog nose mark) that appears in the reference image: ' +
        'a rounded heart-shaped loop forming the muzzle, with three short whisker strokes fanning out to the left. ' +
        'Delete all lettering, words and typography completely — no text of any kind. ' +
        'Keep exactly the same minimal single-line-weight outline style, rounded line caps, and the small inner loop detail. ' +
        'Draw the stroke in solid teal green (#24998D) with a slightly deeper teal (#1B756C) used only for the inner loop accent. ' +
        'Fully transparent background with real alpha channel (no white, no black, no box, no circle behind the symbol). ' +
        'Center the symbol in a square canvas with generous even padding on every side. ' +
        'Flat 2D vector logo icon, no shadows, no gradients, no texture, no border, crisp clean edges.',
      n: 1,
      response_format: 'url',
      aspect_ratio: '1:1',
      resolution: '1K',
      quality: 'medium',
      output_format: 'png',
      background: 'transparent',
      reference_image_urls: [referenceUrl],
    });

    const url = data?.[0]?.url || '';
    if (!url) return Response.json({ error: 'No image returned' }, { status: 502 });
    return Response.json({ url });
  } catch (error) {
    return Response.json({ error: error.message }, { status: 500 });
  }
}


