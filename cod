import React, { useState } from 'react';
import { Star } from 'lucide-react';
import { base44 } from '@/api/base44Client';
import { Button } from '@/components/ui/button';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import { refreshProviderRating } from '@/lib/providerRating';
import { cn } from '@/lib/utils';

export default function ReviewForm({ request, onSubmitted }) {
  const [rating, setRating] = useState(0);
  const [comment, setComment] = useState('');
  const [error, setError] = useState('');
  const [saving, setSaving] = useState(false);

  const submit = async (event) => {
    event.preventDefault();
    if (!rating) {
      setError('Escolha uma nota de 1 a 5 estrelas.');
      return;
    }
    if (comment.trim().length < 10) {
      setError('Conte um pouco mais sobre o serviço (pelo menos 10 caracteres).');
      return;
    }
    setError('');
    setSaving(true);
    try {
      const serviceDate = request.completed_at || new Date().toISOString();
      await base44.entities.Review.create({
        request_id: request.id,
        provider_id: request.provider_id,
        provider_name: request.provider_name,
        service_label: request.service_label,
        service_date: serviceDate,
        author_name: request.client_name,
        author_email: request.client_email,
        rating,
        comment: comment.trim(),
        date: serviceDate,
      });
      await base44.entities.ContactRequest.update(request.id, { reviewed: true });
      await refreshProviderRating(request.provider_id);
      onSubmitted?.();
    } catch (err) {
      setError('Não foi possível enviar a avaliação agora. Tente novamente.');
    } finally {
      setSaving(false);
    }
  };

  return (
    <form className="space-y-4" onSubmit={submit}>
      <div className="space-y-2">
        <Label>Nota</Label>
        <div className="flex gap-1">
          {[1, 2, 3, 4, 5].map((value) => (
            <button
              key={value}
              type="button"
              aria-label={`${value} estrela${value > 1 ? 's' : ''}`}
              onClick={() => setRating(value)}
              className="rounded-lg p-1.5 transition-colors hover:bg-secondary"
            >
              <Star
                className={cn(
                  'h-8 w-8',
                  value <= rating ? 'fill-current text-amber-500' : 'text-muted-foreground/50'
                )}
              />
            </button>
          ))}
        </div>
      </div>
      <div className="space-y-2">
        <Label htmlFor="review-comment">Como foi o serviço</Label>
        <Textarea
          id="review-comment"
          value={comment}
          onChange={(event) => setComment(event.target.value)}
          rows={4}
          placeholder="Conte como foi o atendimento, a pontualidade e o cuidado com o seu pet."
        />
      </div>
      <div className="rounded-2xl bg-secondary/50 p-3 text-sm text-muted-foreground">
        Sua avaliação fica ligada a esta contratação concluída e aparece com o serviço contratado e a data de
        conclusão.
      </div>
      {error ? <p className="text-sm text-destructive">{error}</p> : null}
      <Button type="submit" className="h-11 w-full" disabled={saving}>
        {saving ? 'Enviando...' : 'Enviar avaliação'}
      </Button>
    </form>
  );
}

