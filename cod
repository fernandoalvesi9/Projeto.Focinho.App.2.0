            ajude a reunir cada pet com a sua família.
          </p>
        </div>
        <Button size="lg" onClick={() => setOpen(true)}>
          <Plus className="mr-2 h-4 w-4" />
          Publicar alerta
        </Button>
      </div>

      <SafetyNotice className="mt-6" />

      <div className="mt-8">
        <LostPetMap pets={visible} />
      </div>

      <div className="mt-8 flex flex-wrap items-center justify-between gap-3">
        <div className="flex gap-2">
          {FILTERS.map((item) => (
            <button
              key={item}
              type="button"
              onClick={() => setFilter(item)}
              className={cn(
                'rounded-full border px-4 py-2 text-sm font-medium transition-colors',
                filter === item
                  ? 'border-primary bg-primary text-primary-foreground'
                  : 'border-border bg-background text-muted-foreground hover:text-foreground'
              )}
            >
              {item}
            </button>
          ))}
        </div>
        {!loading ? (
          <p className="text-sm text-muted-foreground">{visible.length} alertas na região</p>
        ) : null}
      </div>

      <div className="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {loading ? (
          [0, 1, 2].map((item) => <Skeleton key={item} className="h-28 rounded-2xl" />)
        ) : visible.length ? (
          visible.map((pet) => <LostPetCard key={pet.id} pet={pet} />)
        ) : (
          <div className="rounded-2xl border border-dashed border-border p-10 text-center sm:col-span-2 lg:col-span-3">
            <p className="font-heading text-lg font-semibold">Nenhum alerta por aqui</p>
            <p className="mt-1 text-sm text-muted-foreground">
              Quando um pet desaparecer na sua região, o aviso aparece nesta lista.
            </p>
          </div>
        )}
      </div>

      <ReportLostPetDialog
        open={open}
        onOpenChange={setOpen}
        onCreated={(pet) => setPets((prev) => [pet, ...prev])}
      />
    </div>
  );
}




