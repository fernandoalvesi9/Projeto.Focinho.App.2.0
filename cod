import React, { useState } from 'react';
import { Copy, MessageCircle, Share2 } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { alertUrl } from '@/lib/pets';
import { cn } from '@/lib/utils';

export default function ShareAlertMenu({ pet, className }) {
  const [copied, setCopied] = useState(false);
  const url = alertUrl(pet.id);
  const text = `${pet.title} — ajude a divulgar: ${url}`;

  const copy = async () => {
    try {
      await navigator.clipboard.writeText(url);
      setCopied(true);
      setTimeout(() => setCopied(false), 2500);
    } catch (err) {
      setCopied(false);
    }
  };

  const share = async () => {
    if (navigator.share) {
      try {
        await navigator.share({ title: pet.title, text: pet.description || '', url });
        return;
      } catch (err) {
        return;
      }
    }
    copy();
  };

  return (
    <div className={cn('flex flex-wrap gap-2', className)}>
      <Button type="button" variant="outline" className="h-10 flex-1 sm:flex-none" onClick={share}>
        <Share2 className="mr-2 h-4 w-4" />
        Compartilhar
      </Button>
      <Button type="button" variant="outline" className="h-10 flex-1 sm:flex-none" asChild>
        <a href={`https://wa.me/?text=${encodeURIComponent(text)}`} target="_blank" rel="noopener noreferrer">
          <MessageCircle className="mr-2 h-4 w-4" />
          WhatsApp
        </a>
      </Button>
      <Button type="button" variant="outline" className="h-10 flex-1 sm:flex-none" onClick={copy}>
        <Copy className="mr-2 h-4 w-4" />
        {copied ? 'Link copiado' : 'Copiar link'}
      </Button>
    </div>
  );
}

